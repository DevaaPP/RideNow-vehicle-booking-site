# ==============================================================================
# RideNow / Jaatri SocketServer Environment Variables
# Copy this file to .env and configure with your credentials.
# ==============================================================================

# Port to listen on (Default: 5000 for local dev, 8000/10000 on Render)
PORT=5000

# MongoDB Connection String (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/rydex

# Cryptographic Secret shared with Next.js app for internal /emit and token validation
SOCKET_INTERNAL_SECRET=generate_a_secure_random_socket_secret_here

# Optional: NextAuth secret (can be used as fallback validation secret)
AUTH_SECRET=your_nextauth_secret_key_here

# Allowed Frontend Origins (Comma-separated for multiple domains)
NEXT_BASE_URL=http://localhost:3000,https://ride-now-vehicle-booking-site.vercel.app
